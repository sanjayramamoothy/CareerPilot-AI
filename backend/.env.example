# Flask Server Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1

# Supabase Project Configuration
# IMPORTANT: The URL and Anon Key are used by both backend and frontend.
# The Service Role Key is strictly backend-only and should never be exposed.
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_ANON_KEY=your-public-anon-anon-key-frontend-safe
SUPABASE_SERVICE_ROLE_KEY=your-private-supabase-service-role-key-backend-only

# Firebase Configuration
# Optional: Path to the Firebase service account private key JSON file.
# If empty or missing, backend will gracefully fall back to Mock Mode for local testing.
FIREBASE_SERVICE_ACCOUNT_JSON=
